{
    "compilerOptions": {
      "outDir": "./.next/",
      "noImplicitAny": true,
      "module": "esnext",
      "target": "es2020",
      "jsx": "react-jsx",
      "allowJs": true,
      "strict": true,
      "lib": [
        "dom",
        "dom.iterable",
        "esnext"
      ],
      "skipLibCheck": true,
      "noEmit": true,
      "incremental": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "types": ["vite/client"],
      "resolveJsonModule": true,
      "isolatedModules": true
    },
    "include": ["./src"],
    "exclude": [
      "node_modules"
    ]
  }
