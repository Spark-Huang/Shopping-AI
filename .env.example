# Shopping AI - environment variables
# Copy to .env (never commit .env) and adjust for your setup.

# --- LLM / embedding / safety API keys (OpenAI-compatible gateway) ---
# Against a local gateway any non-empty value passes gateway auth.
LLM_API_KEY=set-me
EMBED_API_KEY=set-me
SAFETY_API_KEY=set-me

# --- OpenAI-compatible gateway endpoints ---
# The tracked configs only carry the neutral placeholder
# http://llm-gateway:8000/v1; set the real gateway URL(s) here.
# compose passes these into the services, which override the YAML
# placeholder at load time. Local (non-Docker) runs: the local runner reads
# .env and the services fall back to LLM_BASE_URL/localhost.
LLM_BASE_URL=http://llm-gateway:8000/v1
EMBED_BASE_URL=http://llm-gateway:8000/v1
SAFETY_BASE_URL=http://llm-gateway:8000/v1

# --- Model names served by the gateway ---
LLM_NAME=set-me
EMBED_NAME=set-me
# Optional image embedding model. Leave empty to disable image-based catalog
# search (image uploads gracefully degrade to text retrieval).
IMAGE_MODEL_NAME=

# --- Auth (JWT) ---
# Shared secret used to sign/verify login tokens; memory mints them,
# orchestrator verifies them. Set a long random value per deployment.
JWT_SECRET=set-me-to-a-long-random-string
# --- Long-term memory (cognee + shared Milvus) ---
# Set MEMORY_EMBEDDING_ENABLED=false to keep SQLite messages/context only.
MEMORY_EMBEDDING_ENABLED=true
MILVUS_HOST=milvus
MILVUS_PORT=19530
MEMORY_COGNEE_DATASET=shopping_ai_memory
# Optional explicit endpoint; defaults to http://$MILVUS_HOST:$MILVUS_PORT.
MILVUS_URI=
# Optional provider and dimension overrides. Endpoints/models/keys reuse the
# LLM and embedding values above unless overridden here.
COGNEE_LLM_PROVIDER=openai
COGNEE_EMBEDDING_PROVIDER=openai
COGNEE_EMBEDDING_DIMENSIONS=3072
COGNEE_LLM_ENDPOINT=
COGNEE_LLM_MODEL=
COGNEE_LLM_API_KEY=
COGNEE_EMBEDDING_ENDPOINT=
COGNEE_EMBEDDING_MODEL=
COGNEE_EMBEDDING_API_KEY=

# --- Config override (optional) ---
# CONFIG_OVERRIDE=config-build.yaml
